ANTHROPIC_API_KEY=
PANTRYPILOT_LLM_MODEL=
RECIPEAPI_IO_API_KEY=

# Must be exactly one of: development, test, production. An
# unrecognized value fails at startup (2026-09-13 security hardening
# patch) rather than silently being treated as development -- this
# controls, among other things, whether the admin session cookie is
# marked Secure and whether /docs, /redoc, /openapi.json are served.
ENVIRONMENT=development
# Canonical format: a JSON list, e.g.
#   ALLOWED_ORIGINS=["https://example.com","https://admin.example.com"]
# A single bare origin or a comma-separated list are also accepted:
#   ALLOWED_ORIGINS=https://130.162.185.187
# Leaving this empty (as below) disables CORS for any origin -- fine
# for local development, never sufficient for production. "*" is never
# accepted. Each origin must be exactly scheme://host[:port] (http or
# https, no path, no trailing slash).
ALLOWED_ORIGINS=

# Admin dashboard (feature/admin-ingredient-dashboard). Leave all three
# unset to keep /api/admin/* disabled (returns 503 ADMIN_NOT_CONFIGURED).
# Generate PANTRYPILOT_ADMIN_PASSWORD_HASH with:
#   python scripts/hash_admin_password.py
# Generate PANTRYPILOT_ADMIN_SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (must be at least 32 characters when set -- validated at startup)
# Never commit real values for these three.
PANTRYPILOT_ADMIN_USERNAME=
PANTRYPILOT_ADMIN_PASSWORD_HASH=
PANTRYPILOT_ADMIN_SESSION_SECRET=

# Quota-aware recommendation depth (2026-09-13). Leave both unset to
# use the safe defaults below. See
# docs/admin/RECOMMENDATION_DEPTH_AND_RUNTIME_INTEGRATION.md for the
# full explanation and post-trial rollback guidance.
# Default 10 (2026-09-13 recommendation-behavior fix: 25 let a single
# search page exhaust the entire 20-candidate evaluation cap before a
# second page was ever fetched -- see app/config.py's comment).
PANTRYPILOT_RECIPEAPI_PAGE_SIZE=10
# Default 6 -- how many strong, same-anchor grounded candidates the
# agent tries to find before treating the pool as "enough" (advisory
# only; the LLM still controls the actual stop decision).
PANTRYPILOT_TARGET_FEASIBLE_RESULTS=6
